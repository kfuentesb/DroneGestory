classDiagram

    class HabilitacionNM {
	    -int id_piloto
	    -int id_certificacion
	    +Date fecha_alta
	    +Date fecha_caducidad
    }

    class Piloto {
	    -int id_piloto
      -int id_usuario
    }

    class Certificacion {
	    -int id_certificacion
	    +String nombre
	    +String tipo
    }

    class Operacion {
	    -int id_operacion
	    -int id_usuario
      +String nombre_operacion
	    +int current_step
    }

    class Anexo4{
      -int id_anexo_1
      -int id_operacion
      +String descripcion_objetivos
      +Date fecha_hora_prevista
      +int id_tabla_personal_nm
      +int id_drones_nm
      +String medios_materiales
      +String direccion
      +String coords
      +String imagen_espacio_aereo
    }

    class Anexo4_personal{
      -int id_anexo4
      -int id_usuario
      +String rol
      +String licencias
    }

    class Anexo4_drones{
      -int id_anexo4
      -int id_aeronave
      +String uso_previsto
    }

    class Anexo5{
      -int id_anexo_1
      -int id_operacion
    }

    class Anexo6{
      -int id_anexo_1
      -int id_operacion
    }

    class Anexo7{
      -int id_anexo_1
      -int id_operacion
    }

    class AeroNave {
        -int aircraft_id PK
        +ApplicantType applicant_type
        +string applicant_name
        +string manufacturer_name
        +string operador_name
        +int operator_number
        +boolean privately_built
        +string model
        +AircraftType type
        +int serial_number
        +AircraftClass class
        +double mtom
        +double wingspan
        +double max_speed
        +double impact_energy
        +int max_autonomy
        +boolean camera
        +boolean tether
        +double cable_length
        +PowerSource power_source
        +PowerSourceType power_source_type
        +string accessories
        +string observations
        +string image_path
        +LocalDate purchase_date
    }

    class Aseguradora {
	    -int id_seguro
	    +String nombre
	    +Date fecha_comienzo
	    +Date fecha_caducidad
	    +Long importe
    }

    class Operadora {
	    -int id_operadora
	    +String nombre
      +int id_fidscal
      +int num_operadora
      +int codigo_secreto_rid
      +String path_certificado_easa
      +String path_certificado_no_easa
      +String direccion
      +int cod_postal
      +String poblacion
      +String provincia
      +String email
      +int num_telefono
    }

    class Usuario{
      -int id_usuario
      -int id_operadora
      +string nombre
      +String apellidos
      +String nombre_usuario
      +String password
      +String correo
      +int num_telefono
      +String tipo_usuario
      +String path_imagen
    }

    Piloto "1" -- "n" HabilitacionNM
    Certificacion "1" -- "n" HabilitacionNM
    Piloto "1" -- "n" Operacion
    AeroNave "1" -- "n" Operacion
    AeroNave "1" -- "n" Aseguradora
    Piloto "n" --|> "1" Usuario
    Usuario "n" --|> "1" Operadora
    AeroNave "n" <|-- "1" Operadora

    --OPERACIONES

    Operacion "1" -- "1" Anexo4 : contiene
    Anexo4 "1" -- "*" Anexo4_Personal : asigna
    Usuario "1" -- "*" Anexo4_Personal : participa
    Anexo4 "1" -- "*" Anexo4_Aeronaves : utiliza
    AeroNave "1" -- "*" Anexo4_Aeronaves : es_usada